#!/bin/sh
set -e

# Keep settings restored from earlier RexWrt R28S installations.
if [ "$(uci -q get network.doorlink)" = interface ]; then
  exit 0
fi

state=$(mktemp -d)
trap 'rm -rf "$state"' EXIT
config() { uci -t "$state" "$@"; }

find_section() {
  local section
  for section in $(config -X show "$1" | awk -F= -v type="$2" '$2 == type && $1 ~ /^[^.]+[.][^.]+$/ {print $1}'); do
    if [ "$(config -q get "$section.name")" = "$3" ]; then
      printf '%s\n' "$section"
      return
    fi
  done
  return 1
}

delete_if_present() {
  if config -q get "$1" >/dev/null; then
    config delete "$1"
  fi
}

# The LAN bridge has no wired ports; both Ethernet ports belong to doorlink.
lan_bridge=$(find_section network device br-lan) || lan_bridge=network.br_lan
config set "$lan_bridge=device"
config set "$lan_bridge.name=br-lan"
config set "$lan_bridge.type=bridge"
config set "$lan_bridge.bridge_empty=1"
delete_if_present "$lan_bridge.ports"
delete_if_present network.lan.ipaddr
delete_if_present network.lan.netmask
delete_if_present network.wan6
delete_if_present network.wan
config set network.lan=interface
config set network.lan.device=br-lan
config set network.lan.proto=static
config set network.lan.ipaddr=192.168.5.1
config set network.lan.netmask=255.255.255.0
config set network.lan.ip6assign=60

config set network.br_doorlink=device
config set network.br_doorlink.name=br-doorlink
config set network.br_doorlink.type=bridge
delete_if_present network.br_doorlink.ports
config add_list network.br_doorlink.ports=eth0
config add_list network.br_doorlink.ports=eth1
config set network.doorlink=interface
config set network.doorlink.device=br-doorlink
config set network.doorlink.proto=static
config set network.doorlink.ipaddr=172.16.0.201
config set network.doorlink.netmask=255.255.0.0

# Keep the detected radio identity and use the AP mode verified on R28S.
[ -f /etc/config/wireless ] || touch /etc/config/wireless
if ! config -q get wireless.radio0 >/dev/null; then
  config set wireless.radio0=wifi-device
  config set wireless.radio0.type=mac80211
fi
if ! config -q get wireless.radio0.path >/dev/null &&
   ! config -q get wireless.radio0.phy >/dev/null &&
   ! config -q get wireless.radio0.macaddr >/dev/null; then
  config set wireless.radio0.phy=phy0
fi
config set wireless.radio0.band=2g
config set wireless.radio0.channel=1
config set wireless.radio0.htmode=HT20
config set wireless.radio0.country=CN
config set wireless.radio0.disabled=0
config set wireless.default_radio0=wifi-iface
config set wireless.default_radio0.device=radio0
config set wireless.default_radio0.disabled=0
config set wireless.default_radio0.network=lan
config set wireless.default_radio0.mode=ap
config set wireless.default_radio0.encryption=psk2
config set wireless.default_radio0.key=abcd1234
config set wireless.default_radio0.ssid=DOORLINK

# Keep OpenWrt's rules and masquerading; change only the R28S WAN and policies.
wan_zone=$(find_section firewall zone wan)
delete_if_present "$wan_zone.network"
config add_list "$wan_zone.network=doorlink"
config set "$wan_zone.forward=ACCEPT"
config set 'firewall.@defaults[0].input=ACCEPT'
config set 'firewall.@defaults[0].forward=ACCEPT'

# Commit network last because doorlink marks a completed first boot.
for package in wireless firewall network; do
  config commit "$package"
done
